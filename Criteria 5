#include "mbed.h"

#define BLINK_ON_TIME  200ms
#define BLINK_OFF_TIME 200ms

void blinkLedPattern(DigitalOut& led1, DigitalOut& led2, DigitalOut& led3, int blinkCount) {
    for (int i = 0; i < blinkCount; i++) {
        led1 = 1;
        led2 = 1;
        led3 = 1;
        ThisThread::sleep_for(BLINK_ON_TIME);

        led1 = 0;
        led2 = 0;
        led3 = 0;
        ThisThread::sleep_for(BLINK_OFF_TIME);
    }

    led1 = 1;
    led2 = 0;
    led3 = 0;
}

int main()
{
    DigitalOut led1(LED1);
    DigitalOut led2(LED2);
    DigitalOut led3(LED3);

    led1 = 0;
    led2 = 0;
    led3 = 0;

    blinkLedPattern(led1, led2, led3, 5);

    while (true) {
        ThisThread::sleep_for(1s);
    }
}
